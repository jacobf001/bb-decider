<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=1">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="theme-color" content="#0a0e1a">
<title>BB Decider</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0a0e1a;
    --surface: #131826;
    --surface-2: #1a2032;
    --border: #232b40;
    --text: #e8ecf5;
    --text-dim: #8590a8;
    --text-faint: #4a5470;
    --accent: #d9ff00;
    --accent-dim: #aacc00;
    --green: #4ade80;
    --green-dim: #1d4a30;
    --red: #ff4d6d;
    --red-dim: #4a1d28;
    --amber: #ffb84d;
    --amber-dim: #4a3520;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
  }

  html, body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 16px;
    line-height: 1.5;
    overscroll-behavior: none;
    min-height: 100vh;
    min-height: 100dvh;
  }

  body {
    background:
      radial-gradient(ellipse at top, rgba(217,255,0,0.04), transparent 60%),
      var(--bg);
    padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
    max-width: 480px;
    margin: 0 auto;
  }

  .header {
    padding: 1.25rem 1.25rem 0.75rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
  }

  .logo {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.02em;
  }
  .logo .dot { color: var(--accent); }

  .tabs {
    display: flex;
    gap: 0;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .tab {
    flex: 1;
    padding: 0.85rem 0.5rem;
    font: inherit;
    font-size: 0.78rem;
    font-weight: 500;
    background: transparent;
    color: var(--text-dim);
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: color 0.15s, border-color 0.15s;
  }
  .tab.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .screen { display: none; padding: 1.25rem; padding-bottom: 5rem; }
  .screen.active { display: block; }

  .step {
    margin-bottom: 1.5rem;
  }
  .step-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: var(--text-faint);
    margin-bottom: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .step-num {
    background: var(--accent);
    color: var(--bg);
    border-radius: 50%;
    width: 1.1rem;
    height: 1.1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.65rem;
  }

  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
  .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.5rem; }
  .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.4rem; }

  .chip {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-dim);
    padding: 0.85rem 0.75rem;
    border-radius: 0.6rem;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    text-align: center;
    transition: all 0.12s;
    line-height: 1.2;
  }
  .chip:active { transform: scale(0.97); }
  .chip.active {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
    font-weight: 600;
  }

  .input-row {
    display: flex;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.6rem;
    overflow: hidden;
  }
  .input-row input {
    flex: 1;
    padding: 1rem;
    background: transparent;
    border: none;
    color: var(--text);
    font: inherit;
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.1rem;
    font-weight: 500;
    outline: none;
    text-align: center;
    -webkit-appearance: none;
    appearance: none;
  }
  .input-row input::placeholder { color: var(--text-faint); }

  .stepper-btn {
    background: var(--surface-2);
    border: none;
    color: var(--text);
    width: 3rem;
    font-size: 1.5rem;
    cursor: pointer;
  }
  .stepper-btn:active { background: var(--border); }

  .quick-line {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.4rem;
    margin-top: 0.5rem;
  }
  .quick-line .chip { padding: 0.6rem 0.3rem; font-size: 0.78rem; }

  .line-select {
    width: 100%;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 1rem;
    border-radius: 0.6rem;
    font: inherit;
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.05rem;
    font-weight: 500;
    outline: none;
    cursor: pointer;
    text-align: center;
    text-align-last: center;
    appearance: none;
    -webkit-appearance: none;
    background-image: url("data:image/svg+xml;charset=US-ASCII,%3Csvg xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg' viewBox%3D'0 0 16 16'%3E%3Cpath fill%3D'%238590a8' d%3D'M8 11L3 6h10z'%2F%3E%3C%2Fsvg%3E");
    background-repeat: no-repeat;
    background-position: right 1rem center;
    background-size: 1rem;
    padding-right: 2.5rem;
  }
  .line-select:focus { border-color: var(--accent); }
  .line-select option { background: var(--surface); color: var(--text); }

  .verdict {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.85rem;
    padding: 1.5rem 1.25rem;
    margin-top: 0.5rem;
    text-align: center;
  }

  .verdict-empty {
    color: var(--text-faint);
    font-style: italic;
  }

  .verdict-icon {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .verdict-headline {
    font-size: 1.6rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
    letter-spacing: -0.02em;
  }
  .verdict.take { border-color: var(--green-dim); background: linear-gradient(180deg, var(--green-dim), var(--surface)); }
  .verdict.take .verdict-headline { color: var(--green); }
  .verdict.skip { border-color: var(--red-dim); background: linear-gradient(180deg, var(--red-dim), var(--surface)); }
  .verdict.skip .verdict-headline { color: var(--red); }
  .verdict.marginal { border-color: var(--amber-dim); background: linear-gradient(180deg, var(--amber-dim), var(--surface)); }
  .verdict.marginal .verdict-headline { color: var(--amber); }

  .verdict-reason {
    color: var(--text-dim);
    font-size: 0.9rem;
    line-height: 1.4;
    margin-bottom: 1rem;
  }

  .stat-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0.75rem;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
    margin-top: 0.5rem;
  }
  .stat {
    text-align: center;
  }
  .stat-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }
  .stat-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text);
  }
  .stat-value.pos { color: var(--green); }
  .stat-value.neg { color: var(--red); }

  .log-btn {
    width: 100%;
    background: var(--accent);
    color: var(--bg);
    border: none;
    padding: 1rem;
    border-radius: 0.6rem;
    font: inherit;
    font-weight: 700;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    margin-top: 1rem;
  }
  .log-btn:active { transform: scale(0.98); }
  .log-btn.secondary {
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
  }

  .bet-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.6rem;
    padding: 0.85rem;
    margin-bottom: 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .bet-card-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .bet-card-game {
    font-weight: 600;
    font-size: 0.9rem;
  }
  .bet-card-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--text-dim);
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .bet-card-meta span {
    background: var(--surface-2);
    padding: 0.15rem 0.5rem;
    border-radius: 0.3rem;
  }
  .bet-card-actions {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
    gap: 0.3rem;
    margin-top: 0.4rem;
  }
  .result-btn {
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--text-dim);
    padding: 0.5rem 0.2rem;
    border-radius: 0.4rem;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
  }
  .result-btn:active { transform: scale(0.95); }
  .result-btn.W { color: var(--green); }
  .result-btn.HW { color: var(--green); opacity: 0.8; }
  .result-btn.P { color: var(--text-dim); }
  .result-btn.HL { color: var(--red); opacity: 0.8; }
  .result-btn.L { color: var(--red); }

  .summary-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .summary-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.6rem;
    padding: 1rem;
  }
  .summary-card .label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.4rem;
  }
  .summary-card .value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .summary-card .value.pos { color: var(--green); }
  .summary-card .value.neg { color: var(--red); }
  .summary-card .sub {
    color: var(--text-dim);
    font-size: 0.75rem;
    margin-top: 0.2rem;
    font-family: 'JetBrains Mono', monospace;
  }

  .notif-summary {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.6rem;
    padding: 0.85rem 1rem;
    margin-bottom: 0.6rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .notif-summary-name { font-weight: 600; font-size: 0.9rem; }
  .notif-summary-stats {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    color: var(--text-dim);
  }
  .notif-summary-roi {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 1rem;
  }
  .empty-state {
    text-align: center;
    color: var(--text-faint);
    padding: 3rem 1rem;
    font-size: 0.9rem;
  }

  .section-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 1.5rem 0 0.6rem;
  }

  .game-input {
    width: 100%;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 0.85rem 1rem;
    border-radius: 0.6rem;
    font: inherit;
    font-size: 0.9rem;
    outline: none;
    margin-bottom: 0.5rem;
  }
  .game-input:focus { border-color: var(--accent); }

  .toast {
    position: fixed;
    bottom: calc(1.5rem + env(safe-area-inset-bottom));
    left: 50%;
    transform: translateX(-50%) translateY(2rem);
    background: var(--accent);
    color: var(--bg);
    padding: 0.75rem 1.5rem;
    border-radius: 2rem;
    font-weight: 600;
    font-size: 0.85rem;
    opacity: 0;
    transition: all 0.25s ease;
    pointer-events: none;
    z-index: 100;
  }
  .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

  /* Settings */
  .setting-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }
  .setting-row:last-child { border-bottom: none; }
  .setting-label { font-size: 0.95rem; }
  .setting-input {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 0.5rem 0.75rem;
    border-radius: 0.4rem;
    font: inherit;
    font-family: 'JetBrains Mono', monospace;
    width: 6rem;
    text-align: right;
    outline: none;
  }
</style>
</head>
<body>

<div class="header">
  <div class="logo">BB<span class="dot">.</span>decider <span style="color:var(--text-faint); font-size:0.65rem;">v2</span></div>
  <div style="font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; color: var(--text-faint);" id="header-stats">— bets · — ROI</div>
</div>

<nav class="tabs">
  <button class="tab active" data-screen="decide">Decide</button>
  <button class="tab" data-screen="pending">Pending</button>
  <button class="tab" data-screen="stats">Stats</button>
  <button class="tab" data-screen="settings">⚙</button>
</nav>

<!-- DECIDE SCREEN -->
<section class="screen active" id="screen-decide">

  <div class="step">
    <div class="step-label"><span class="step-num">1</span>Notification</div>
    <div class="grid-2" id="notif-chips" style="grid-template-columns: 1fr 1fr; gap: 0.5rem;">
      <button class="chip" data-val="fh-00">FH 0-0</button>
      <button class="chip" data-val="home-asian">Home Asian</button>
      <button class="chip" data-val="ht-pressure">HT Pressure</button>
      <button class="chip" data-val="fh-pressure">FH Pressure FT GL</button>
      <button class="chip" data-val="sh-low-line" style="grid-column: 1 / -1;">SH Low Line</button>
    </div>
  </div>

  <div class="step">
    <div class="step-label"><span class="step-num">2</span>Market</div>
    <div class="grid-2" id="market-chips">
      <button class="chip" data-val="gl">Goal Line</button>
      <button class="chip" data-val="ah">Asian Handicap</button>
    </div>
  </div>

  <div class="step">
    <div class="step-label"><span class="step-num">3</span>Line</div>
    <select id="line-select" class="line-select">
      <option value="">Select market first</option>
    </select>
  </div>

  <div class="step">
    <div class="step-label"><span class="step-num">4</span>Odds offered</div>
    <div class="input-row">
      <button class="stepper-btn" id="odds-down">−</button>
      <input type="number" id="odds-input" step="0.05" placeholder="1.85" inputmode="decimal">
      <button class="stepper-btn" id="odds-up">+</button>
    </div>
  </div>

  <div class="verdict" id="verdict">
    <div class="verdict-empty">Select notification, market, line and odds to get a verdict</div>
  </div>

  <div id="log-section" style="display:none;">
    <div class="section-title">Log this bet</div>
    <input type="text" class="game-input" id="game-input" placeholder="Home vs Away (optional)">
    <div class="grid-2">
      <button class="log-btn secondary" id="clear-btn">Clear</button>
      <button class="log-btn" id="log-btn">Log Bet</button>
    </div>
  </div>

</section>

<!-- PENDING -->
<section class="screen" id="screen-pending">
  <div id="pending-list"></div>
  <div class="empty-state" id="pending-empty">No pending bets. Log one from the Decide tab.</div>
</section>

<!-- STATS -->
<section class="screen" id="screen-stats">
  <div class="summary-grid">
    <div class="summary-card">
      <div class="label">Total Bets</div>
      <div class="value" id="stat-total">0</div>
      <div class="sub" id="stat-pending">0 pending</div>
    </div>
    <div class="summary-card">
      <div class="label">Win Rate</div>
      <div class="value" id="stat-winrate">—</div>
      <div class="sub" id="stat-wins">— W / — L</div>
    </div>
    <div class="summary-card">
      <div class="label">Total Staked</div>
      <div class="value" id="stat-staked">£0</div>
    </div>
    <div class="summary-card">
      <div class="label">Profit</div>
      <div class="value" id="stat-profit">£0</div>
      <div class="sub" id="stat-roi">— ROI</div>
    </div>
  </div>

  <div class="section-title">By Notification</div>
  <div id="notif-stats"></div>
</section>

<!-- SETTINGS -->
<section class="screen" id="screen-settings">
  <div class="section-title">Stake</div>
  <div class="setting-row">
    <div class="setting-label">Default stake</div>
    <input type="number" class="setting-input" id="default-stake" step="0.5" min="0">
  </div>
  <div class="setting-row">
    <div class="setting-label">Bankroll</div>
    <input type="number" class="setting-input" id="bankroll" step="5" min="0">
  </div>

  <div class="section-title">Data</div>
  <div class="setting-row">
    <div class="setting-label">Export bets (JSON)</div>
    <button class="result-btn" id="export-btn" style="padding:0.5rem 0.85rem; color: var(--accent);">Export</button>
  </div>
  <div class="setting-row">
    <div class="setting-label">Clear all data</div>
    <button class="result-btn" id="clear-data-btn" style="padding:0.5rem 0.85rem; color: var(--red);">Clear</button>
  </div>

  <div class="section-title">About</div>
  <div style="color: var(--text-dim); font-size: 0.85rem; line-height: 1.5; margin-top: 0.5rem;">
    Decision engine updated to match the final BetBallers alert rules from the ROI review. Uses flat staking from your settings, not Kelly staking. Tap "Add to Home Screen" in your browser menu to install as an app. All data stored locally on your device.
  </div>
</section>

<div class="toast" id="toast">Logged</div>

<script>
// ============== DECISION RULES ==============
// Each notification has rules per market that determine take/skip/marginal verdicts.
// Rules are derived from the backtest analysis we ran together.

const RULES = {
  'fh-00': {
    name: 'FH 0-0',
    allowedMarkets: ['gl'],
    setup: '16–35 mins · 0-0 · Goal Line 1.5–3.5 · Over odds 1.65–2.20',
    gl: [
      { min: 1.50, max: 1.50, roi: 23.33, v: 'take', note: 'Final rule: Over 1.5–3.5. Line ROI +23.3%.' },
      { min: 1.75, max: 1.75, roi: -0.83, v: 'marginal', note: 'Within final range but weakest line. Take only if alert criteria are clean.' },
      { min: 2.00, max: 2.00, roi: 21.69, v: 'take', note: 'Final rule line. Historic ROI +21.7%.' },
      { min: 2.25, max: 2.25, roi: 37.23, v: 'take', note: 'Best FH 0-0 core line. Historic ROI +37.2%.' },
      { min: 2.50, max: 2.50, roi: 5.00, v: 'take', note: 'Within final range. Lower edge but still part of volume rule.' },
      { min: 2.75, max: 2.75, roi: 19.17, v: 'take', note: 'Final rule line. Historic ROI +19.2%.' },
      { min: 3.00, max: 3.00, roi: 44.58, v: 'take', note: 'Strong line in final export. Historic ROI +44.6%.' },
      { min: 3.25, max: 3.25, roi: 25.58, v: 'take', note: 'Final rule line. Historic ROI +25.6%.' },
      { min: 3.50, max: 3.50, roi: 42.50, v: 'take', note: 'Final max line. Historic ROI +42.5%.' },
      { min: -99, max: 1.49, roi: -24.17, v: 'skip', note: 'Outside final range. Do not take below Over 1.5.' },
      { min: 3.51, max: 99, roi: -3.92, v: 'skip', note: 'Outside final range. 3.75+ was weak.' },
    ],
  },
  'home-asian': {
    name: 'Home Asian',
    allowedMarkets: ['ah'],
    setup: '12–20 mins · 0-0 · Home AH -1.0 to 0.0',
    'ah-fav': [
      { min: -1.00, max: -1.00, roi: 15.19, v: 'take', note: 'Final Home Asian range. Historic ROI +15.2%.' },
      { min: -0.75, max: -0.75, roi: -7.58, v: 'marginal', note: 'Within range but weak in backtest. Prefer stronger lines if choosing manually.' },
      { min: -0.50, max: -0.50, roi: 58.19, v: 'take', note: 'Best Home Asian line. Historic ROI +58.2%.' },
      { min: -0.25, max: -0.25, roi: -1.50, v: 'marginal', note: 'Within range but weak in backtest. Take only if alert criteria are clean.' },
    ],
    'ah-zero': [
      { min: -99, max: 99, roi: 47.00, v: 'take', note: 'Home AH 0.0 / DNB performed strongly. Historic ROI +47.0%.' },
    ],
    'ah-dog': [
      { min: -99, max: 99, roi: -15.0, v: 'skip', note: 'Home Asian is for the home side. Positive/underdog AH lines are not part of this rule.' },
    ],
    gl: [
      { min: -99, max: 99, roi: 0, v: 'skip', note: 'Home Asian uses Column N / Home AH only. Do not use Goal Line for this alert.' },
    ],
  },
  'ht-pressure': {
    name: 'Half-Time Pressure',
    allowedMarkets: ['gl'],
    setup: '43–65 mins · Over Goal Line 0.5–1.5 · do not add 1.75',
    gl: [
      { min: 0.50, max: 0.50, roi: 92.50, v: 'take', note: 'Allowed low line, but sample was tiny. Treat as take if alert criteria match.' },
      { min: 0.75, max: 0.75, roi: 11.84, v: 'take', note: 'Allowed line. Historic ROI +11.8%.' },
      { min: 1.00, max: 1.00, roi: 30.14, v: 'take', note: 'Best HT Pressure line. Historic ROI +30.1%.' },
      { min: 1.25, max: 1.25, roi: 7.78, v: 'take', note: 'Allowed line. Historic ROI +7.8%.' },
      { min: 1.50, max: 1.50, roi: 2.15, v: 'take', note: 'Kept for volume. Lower edge than 0.5–1.25.' },
      { min: 1.51, max: 99, roi: 0.87, v: 'skip', note: 'Do not add Over 1.75 back. Higher lines dragged ROI down.' },
    ],
  },
  'fh-pressure': {
    name: 'FH Pressure FT GL',
    allowedMarkets: ['gl'],
    setup: '10–30 mins · Goal Line 1.5–3.5 · Over odds 1.65–2.00',
    gl: [
      { min: 1.50, max: 1.50, roi: 34.36, v: 'take', note: 'Within final range. Overall optimised alert ROI +34.4%.' },
      { min: 1.75, max: 1.75, roi: 34.36, v: 'take', note: 'Within final range. Overall optimised alert ROI +34.4%.' },
      { min: 2.00, max: 2.00, roi: 0.00, v: 'marginal', note: 'Small sample/push-heavy line. Still within final range.' },
      { min: 2.25, max: 2.25, roi: 34.36, v: 'take', note: 'Within final range. Overall optimised alert ROI +34.4%.' },
      { min: 2.50, max: 2.50, roi: 64.10, v: 'take', note: 'Strong line in optimised export. Historic ROI +64.1%.' },
      { min: 2.75, max: 2.75, roi: 26.20, v: 'take', note: 'Final rule line. Historic ROI +26.2%.' },
      { min: 3.00, max: 3.00, roi: -3.70, v: 'marginal', note: 'Weak individual line, but kept in final range for volume.' },
      { min: 3.25, max: 3.25, roi: 42.90, v: 'take', note: 'Strong line in optimised export. Historic ROI +42.9%.' },
      { min: 3.50, max: 3.50, roi: 25.60, v: 'take', note: 'Final max line. Historic ROI +25.6%.' },
      { min: -99, max: 1.49, roi: 0, v: 'skip', note: 'Outside final range. Do not take below Over 1.5.' },
      { min: 3.51, max: 99, roi: -4.30, v: 'skip', note: 'Outside final range. 3.75–4.0 dragged the original alert down.' },
    ],
  },
  'sh-low-line': {
    name: 'SH Low Line',
    allowedMarkets: ['gl'],
    setup: '43–65 mins · Goal Line 0.5–1.25 · Over odds around 1.85–2.00',
    gl: [
      { min: 0.50, max: 0.50, roi: 10.83, v: 'marginal', note: 'Allowed range but limited sample in latest export.' },
      { min: 0.75, max: 0.75, roi: 11.00, v: 'take', note: 'Latest SH Low Line ROI +11.0% on this line.' },
      { min: 1.00, max: 1.00, roi: 7.34, v: 'take', note: 'Latest SH Low Line ROI +7.3% on this line.' },
      { min: 1.25, max: 1.25, roi: 12.45, v: 'take', note: 'Best volume line in latest export. ROI +12.5%.' },
      { min: 1.26, max: 99, roi: 0, v: 'skip', note: 'Outside SH Low Line range. Use Half-Time Pressure if taking Over 1.5.' },
    ],
  },
};

// Min odds floors per notification — anything below = automatic skip
// Odds ranges per notification. These are selection odds, not 1x2 odds.
const MIN_ODDS = {
  'fh-00': 1.65,
  'home-asian': 1.60,
  'ht-pressure': 1.65,
  'fh-pressure': 1.65,
  'sh-low-line': 1.85,
};

const MAX_ODDS = {
  'fh-00': 2.20,
  'home-asian': 2.20,
  'ht-pressure': 2.20,
  'fh-pressure': 2.00,
  'sh-low-line': 2.00,
};

// ============== STATE ==============
const state = {
  notif: null,
  market: null,
  line: null,
  odds: null,
  bets: JSON.parse(localStorage.getItem('bb-bets') || '[]'),
  settings: JSON.parse(localStorage.getItem('bb-settings') || '{"stake":2,"bankroll":100}'),
};

// Line options per market — full set with quarter lines
const LINE_OPTIONS = {
  gl: [0.5, 0.75, 1.0, 1.25, 1.5, 1.75, 2.0, 2.25, 2.5, 2.75, 3.0, 3.25, 3.5, 3.75, 4.0, 4.25, 4.5, 4.75, 5.0],
  ah: [-3.0, -2.75, -2.5, -2.25, -2.0, -1.75, -1.5, -1.25, -1.0, -0.75, -0.5, -0.25, 0, 0.25, 0.5, 0.75, 1.0, 1.25, 1.5, 1.75, 2.0, 2.25, 2.5, 2.75, 3.0],
};

// ============== UI ==============
const $ = sel => document.querySelector(sel);
const $$ = sel => document.querySelectorAll(sel);

// Tabs
$$('.tab').forEach(t => {
  t.addEventListener('click', () => {
    $$('.tab').forEach(x => x.classList.remove('active'));
    t.classList.add('active');
    $$('.screen').forEach(s => s.classList.remove('active'));
    $('#screen-' + t.dataset.screen).classList.add('active');
    if (t.dataset.screen === 'pending') renderPending();
    if (t.dataset.screen === 'stats') renderStats();
    if (t.dataset.screen === 'settings') renderSettings();
  });
});

// Notification chips
$$('#notif-chips .chip').forEach(c => {
  c.addEventListener('click', () => {
    $$('#notif-chips .chip').forEach(x => x.classList.remove('active'));
    c.classList.add('active');
    state.notif = c.dataset.val;
    // Auto-fill odds at 1.85 if empty
    if (!$('#odds-input').value) {
      $('#odds-input').value = '1.85';
      state.odds = 1.85;
    }
    update();
  });
});

// Market chips
$$('#market-chips .chip').forEach(c => {
  c.addEventListener('click', () => {
    $$('#market-chips .chip').forEach(x => x.classList.remove('active'));
    c.classList.add('active');
    state.market = c.dataset.val;
    populateLineDropdown();
    update();
  });
});

function populateLineDropdown() {
  const sel = $('#line-select');
  sel.innerHTML = '<option value="">Select line</option>';
  if (!state.market) return;
  const lines = LINE_OPTIONS[state.market] || [];
  lines.forEach(l => {
    const opt = document.createElement('option');
    opt.value = l;
    let label;
    if (state.market === 'gl') {
      label = 'Over ' + l.toFixed(2);
    } else if (l === 0) {
      label = 'AH 0 (DNB)';
    } else if (l > 0) {
      label = 'AH +' + l;
    } else {
      label = 'AH ' + l;
    }
    opt.textContent = label;
    sel.appendChild(opt);
  });
  // Reset line state
  state.line = null;
}

// Line dropdown
$('#line-select').addEventListener('change', e => {
  state.line = e.target.value === '' ? null : parseFloat(e.target.value);
  update();
});

// Odds input
const oddsInput = $('#odds-input');
oddsInput.addEventListener('input', () => {
  state.odds = parseFloat(oddsInput.value);
  update();
});
$('#odds-up').addEventListener('click', () => {
  const v = ((parseFloat(oddsInput.value) || 1.85) + 0.05).toFixed(2);
  oddsInput.value = v;
  state.odds = parseFloat(v);
  update();
});
$('#odds-down').addEventListener('click', () => {
  const v = ((parseFloat(oddsInput.value) || 1.85) - 0.05).toFixed(2);
  oddsInput.value = v;
  state.odds = parseFloat(v);
  update();
});

// ============== DECISION ENGINE ==============
function getVerdict() {
  if (!state.notif || !state.market || state.line == null || isNaN(state.line) || state.odds == null || isNaN(state.odds)) return null;

  // Route AH to fav/dog/zero based on line sign
  let market = state.market;
  if (state.market === 'ah') {
    if (state.line === 0) market = 'ah-zero';
    else if (state.line < 0) market = 'ah-fav';
    else market = 'ah-dog';
  }

  const notifRules = RULES[state.notif];
  if (!notifRules) return null;

  // Enforce final market mapping.
  // All alerts use Goal Line except Home Asian, which uses Home AH only.
  if (notifRules.allowedMarkets && !notifRules.allowedMarkets.includes(state.market)) {
    return { v: 'skip', note: `${notifRules.name} uses ${notifRules.allowedMarkets.includes('ah') ? 'Home Asian Handicap only' : 'Goal Line only'} — wrong market selected.` };
  }

  const marketRules = notifRules[market];
  if (!marketRules) return { v: 'skip', note: 'No rule for this combination — likely not a play' };

  // Odds range check
  if (MIN_ODDS[state.notif] != null && state.odds < MIN_ODDS[state.notif]) {
    return { v: 'skip', note: `Odds below ${MIN_ODDS[state.notif].toFixed(2)} floor — not enough value` };
  }
  if (MAX_ODDS[state.notif] != null && state.odds > MAX_ODDS[state.notif]) {
    return { v: 'skip', note: `Odds above ${MAX_ODDS[state.notif].toFixed(2)} cap — outside tested range` };
  }

  // Find matching rule
  let match = null;
  for (const r of marketRules) {
    if (state.line >= r.min && state.line <= r.max) {
      match = r;
      break;
    }
  }

  if (!match) {
    return { v: 'marginal', note: 'No backtested data for this exact line — proceed with caution' };
  }

  // EV calc — use historical ROI as expected return
  const ev = match.roi;
  return { v: match.v, note: match.note, ev };
}

function update() {
  const v = getVerdict();
  const el = $('#verdict');
  const logSection = $('#log-section');

  if (!v) {
    el.className = 'verdict';
    el.innerHTML = '<div class="verdict-empty">Select notification, market, line and odds to get a verdict</div>';
    logSection.style.display = 'none';
    return;
  }

  el.className = 'verdict ' + v.v;
  const icon = v.v === 'take' ? '✓' : v.v === 'skip' ? '✕' : '⚠';
  const headline = v.v === 'take' ? 'TAKE IT' : v.v === 'skip' ? 'SKIP' : 'MARGINAL';

  // Flat stake only — no Kelly staking. The displayed stake now matches the logged stake.
  const flatStake = state.settings.stake;

  el.innerHTML = `
    <div class="verdict-icon">${icon}</div>
    <div class="verdict-headline">${headline}</div>
    <div class="verdict-reason">${v.note}</div>
    ${RULES[state.notif]?.setup ? `<div class="verdict-reason" style="font-size:0.8rem; margin-top:0.35rem; color:var(--text-faint);">Rule: ${RULES[state.notif].setup}</div>` : ''}
    <div class="stat-row">
      <div class="stat">
        <div class="stat-label">Hist ROI</div>
        <div class="stat-value ${v.ev > 0 ? 'pos' : v.ev < 0 ? 'neg' : ''}">${v.ev != null ? (v.ev > 0 ? '+' : '') + v.ev.toFixed(0) + '%' : '—'}</div>
      </div>
      <div class="stat">
        <div class="stat-label">Stake</div>
        <div class="stat-value">£${flatStake}</div>
      </div>
      <div class="stat">
        <div class="stat-label">If win</div>
        <div class="stat-value pos">+£${((state.odds - 1) * flatStake).toFixed(2)}</div>
      </div>
    </div>
  `;

  logSection.style.display = v.v === 'skip' ? 'none' : 'block';
}

// ============== LOG BET ==============
$('#log-btn').addEventListener('click', () => {
  if (!state.notif || !state.market || state.line == null || state.odds == null) return;
  const game = $('#game-input').value.trim();

  state.bets.push({
    id: Date.now(),
    notif: state.notif,
    market: state.market,
    line: state.line,
    odds: state.odds,
    stake: state.settings.stake,
    game: game || '—',
    result: null,
    pnl: null,
    timestamp: new Date().toISOString(),
  });
  saveBets();
  toast('Logged');
  clearForm();
});

$('#clear-btn').addEventListener('click', clearForm);

function clearForm() {
  state.notif = null;
  state.market = null;
  state.line = null;
  state.odds = null;
  $$('.chip').forEach(c => c.classList.remove('active'));
  $('#line-select').innerHTML = '<option value="">Select market first</option>';
  $('#odds-input').value = '';
  $('#game-input').value = '';
  update();
}

// ============== PENDING ==============
function renderPending() {
  const list = $('#pending-list');
  const empty = $('#pending-empty');
  list.innerHTML = '';
  const pending = state.bets.filter(b => b.result === null);

  if (pending.length === 0) {
    empty.style.display = 'block';
    return;
  }
  empty.style.display = 'none';

  pending.reverse().forEach(b => {
    const card = document.createElement('div');
    card.className = 'bet-card';
    const notifName = RULES[b.notif]?.name || b.notif;
    const marketName = b.market === 'gl' ? 'Goal Line' : 'AH';
    card.innerHTML = `
      <div class="bet-card-top">
        <div class="bet-card-game">${b.game}</div>
        <div style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: var(--text-dim);">£${b.stake}</div>
      </div>
      <div class="bet-card-meta">
        <span>${notifName}</span>
        <span>${marketName}</span>
        <span>${b.line > 0 && b.market !== 'gl' ? '+' : ''}${b.line}</span>
        <span>@${b.odds}</span>
      </div>
      <div class="bet-card-actions">
        <button class="result-btn W" data-id="${b.id}" data-r="W">W</button>
        <button class="result-btn HW" data-id="${b.id}" data-r="HW">HW</button>
        <button class="result-btn P" data-id="${b.id}" data-r="P">P</button>
        <button class="result-btn HL" data-id="${b.id}" data-r="HL">HL</button>
        <button class="result-btn L" data-id="${b.id}" data-r="L">L</button>
      </div>
    `;
    list.appendChild(card);
  });

  $$('.result-btn[data-id]').forEach(b => {
    b.addEventListener('click', () => settleBet(parseInt(b.dataset.id), b.dataset.r));
  });
}

function settleBet(id, result) {
  const bet = state.bets.find(b => b.id === id);
  if (!bet) return;
  bet.result = result;
  // P&L
  if (result === 'W') bet.pnl = (bet.odds - 1) * bet.stake;
  else if (result === 'HW') bet.pnl = (bet.odds - 1) * bet.stake / 2;
  else if (result === 'P') bet.pnl = 0;
  else if (result === 'HL') bet.pnl = -bet.stake / 2;
  else if (result === 'L') bet.pnl = -bet.stake;
  saveBets();
  renderPending();
  toast('Settled');
}

// ============== STATS ==============
function renderStats() {
  const settled = state.bets.filter(b => b.result !== null);
  const pending = state.bets.filter(b => b.result === null);
  const wins = settled.filter(b => b.result === 'W' || b.result === 'HW').length;
  const losses = settled.filter(b => b.result === 'L' || b.result === 'HL').length;
  const totalStaked = settled.reduce((s, b) => s + b.stake, 0);
  const profit = settled.reduce((s, b) => s + (b.pnl || 0), 0);
  const winRate = settled.length > 0 ? (wins / settled.length * 100).toFixed(1) : '—';
  const roi = totalStaked > 0 ? (profit / totalStaked * 100).toFixed(1) : '—';

  $('#stat-total').textContent = state.bets.length;
  $('#stat-pending').textContent = pending.length + ' pending';
  $('#stat-winrate').textContent = winRate + (winRate !== '—' ? '%' : '');
  $('#stat-wins').textContent = `${wins}W / ${losses}L`;
  $('#stat-staked').textContent = '£' + totalStaked.toFixed(2);
  const profitEl = $('#stat-profit');
  profitEl.textContent = (profit >= 0 ? '+£' : '-£') + Math.abs(profit).toFixed(2);
  profitEl.className = 'value ' + (profit > 0 ? 'pos' : profit < 0 ? 'neg' : '');
  $('#stat-roi').textContent = roi + (roi !== '—' ? '% ROI' : '');

  // Header stats
  $('#header-stats').textContent = `${state.bets.length} bets · ${roi !== '—' ? roi + '%' : '—'} ROI`;

  // Per notification breakdown
  const notifEl = $('#notif-stats');
  notifEl.innerHTML = '';
  const groups = {};
  settled.forEach(b => {
    if (!groups[b.notif]) groups[b.notif] = { bets: 0, wins: 0, staked: 0, profit: 0 };
    groups[b.notif].bets++;
    if (b.result === 'W' || b.result === 'HW') groups[b.notif].wins++;
    groups[b.notif].staked += b.stake;
    groups[b.notif].profit += b.pnl || 0;
  });

  Object.keys(groups).forEach(k => {
    const g = groups[k];
    const r = (g.profit / g.staked * 100).toFixed(1);
    const div = document.createElement('div');
    div.className = 'notif-summary';
    div.innerHTML = `
      <div>
        <div class="notif-summary-name">${RULES[k]?.name || k}</div>
        <div class="notif-summary-stats">${g.bets} bets · ${(g.wins/g.bets*100).toFixed(0)}% W</div>
      </div>
      <div class="notif-summary-roi" style="color: ${g.profit > 0 ? 'var(--green)' : g.profit < 0 ? 'var(--red)' : 'var(--text-dim)'}">${g.profit >= 0 ? '+' : ''}${r}%</div>
    `;
    notifEl.appendChild(div);
  });

  if (settled.length === 0) {
    notifEl.innerHTML = '<div class="empty-state">No settled bets yet</div>';
  }
}

// ============== SETTINGS ==============
function renderSettings() {
  $('#default-stake').value = state.settings.stake;
  $('#bankroll').value = state.settings.bankroll;
}
$('#default-stake').addEventListener('input', e => {
  state.settings.stake = parseFloat(e.target.value) || 2;
  saveSettings();
});
$('#bankroll').addEventListener('input', e => {
  state.settings.bankroll = parseFloat(e.target.value) || 100;
  saveSettings();
});

$('#export-btn').addEventListener('click', () => {
  const data = JSON.stringify({ bets: state.bets, settings: state.settings }, null, 2);
  const blob = new Blob([data], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `bb-bets-${new Date().toISOString().split('T')[0]}.json`;
  a.click();
  URL.revokeObjectURL(url);
});

$('#clear-data-btn').addEventListener('click', () => {
  if (confirm('Clear all logged bets? This cannot be undone.')) {
    state.bets = [];
    saveBets();
    renderStats();
    toast('Cleared');
  }
});

// ============== STORAGE ==============
function saveBets() {
  localStorage.setItem('bb-bets', JSON.stringify(state.bets));
  // Update header
  const settled = state.bets.filter(b => b.result !== null);
  const totalStaked = settled.reduce((s, b) => s + b.stake, 0);
  const profit = settled.reduce((s, b) => s + (b.pnl || 0), 0);
  const roi = totalStaked > 0 ? (profit / totalStaked * 100).toFixed(1) + '%' : '—';
  $('#header-stats').textContent = `${state.bets.length} bets · ${roi} ROI`;
}
function saveSettings() {
  localStorage.setItem('bb-settings', JSON.stringify(state.settings));
}

// ============== TOAST ==============
let toastTimer;
function toast(msg) {
  const t = $('#toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 1500);
}

// Initial render
saveBets();
</script>

</body>
</html>
